# ── WTLL Platform — Backend Environment Variables ─────────────────────────────
#
# Copy this file to .env for local development.
# In production, set these in the Railway dashboard (Variables tab) — never
# commit a production .env file to the repo.
#
# ── Core ──────────────────────────────────────────────────────────────────────

# Generate a strong key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-real-secret-key

# Set to False in production
DEBUG=True

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank in local dev to fall back to SQLite, or point at a local Postgres.
# Production: paste the Neon "pooled" connection string from the Neon dashboard.
#   Format: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── Hosts & CORS ──────────────────────────────────────────────────────────────
# Comma-separated. Add your Railway-generated domain + any custom domain.
# Production example: .railway.app,wtll.org,www.wtll.org
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated Vercel (or custom) frontend origins Django's CORS will allow.
# Production example: https://wtll-platform.vercel.app,https://wtll.org
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Used to build magic-link sign-in URLs in emails.
# Production: https://wtll-platform.vercel.app  (or your custom domain)
FRONTEND_URL=http://localhost:5173

# ── Email (magic-link auth) ────────────────────────────────────────────────────
# Local dev: leave as console backend to print links to the terminal.
# Production: use Resend (resend.com) — free tier, dead simple.
#   1. Create a Resend account and verify your domain
#   2. Generate an API key
#   3. Set the vars below:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_your_resend_api_key_here
DEFAULT_FROM_EMAIL=WTLL Platform <noreply@yourdomain.com>

# ── Google Maps ───────────────────────────────────────────────────────────────
# Required for the Eligibility / address-geocoding feature.
# Get a key at https://console.cloud.google.com → APIs & Services → Geocoding API
GOOGLE_MAPS_API_KEY=
