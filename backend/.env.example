# ── Local development ──────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True

# Local dev: leave DATABASE_URL blank to use the SQLite fallback (see settings.py)
# or point it at a local Postgres instance.
DATABASE_URL=

# Comma-separated. Add your Railway subdomain here in production.
# Production example: .railway.app,your-custom-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed by CORS.
# Production: set to your Vercel deployment URL, e.g. https://wtll.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Maps API key (used for geocoding / eligibility checks)
GOOGLE_MAPS_API_KEY=

# ── Production (Railway) ───────────────────────────────────────────────────────
# Set these in the Railway dashboard under Variables, not here.
#
#   SECRET_KEY              → generate a strong random key
#   DEBUG                   → False
#   DATABASE_URL            → paste the Neon "pooled" connection string
#                             (postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require)
#   ALLOWED_HOSTS           → .railway.app,your-custom-domain.com
#   CORS_ALLOWED_ORIGINS    → https://your-app.vercel.app
#   GOOGLE_MAPS_API_KEY     → production key
