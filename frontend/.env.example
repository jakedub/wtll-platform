# ── Local development ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Production (Vercel) ────────────────────────────────────────────────────────
# Set this in the Vercel dashboard under Settings → Environment Variables.
# Do NOT commit a production .env file.
#
#   VITE_API_URL  →  https://your-backend.railway.app
#
# The variable is baked into the JS bundle at build time, so Vercel must
# have the correct value set before you trigger a deployment.
