# ── WTLL Platform — Frontend Environment Variables ────────────────────────────
#
# Copy this file to .env.local for local development.
# In production, set VITE_API_URL in the Vercel dashboard:
#   Project → Settings → Environment Variables → Production
#
# IMPORTANT: Vite bakes env vars into the JS bundle at build time.
# You must set this BEFORE triggering a Vercel deploy.
#
# ── API endpoint ──────────────────────────────────────────────────────────────
# Local dev: leave blank (empty) OR point at the local Django server.
#   - If blank → Vite's dev proxy forwards /api/* to http://localhost:8000
#   - If set   → the client calls the URL directly (CORS must allow localhost:5173)
# Production: set to your Railway backend URL (no trailing slash, no /api suffix)
#   VITE_API_URL=https://wtll-platform-production.up.railway.app
VITE_API_URL=
